<UserControl FlowDirection="{ReflectionBinding Direction, Source={x:Static loc:LocalizedStrings.Shared}}" xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:UserIdentityDesktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserIdentityDesktop.ViewModels"
             xmlns:model="using:UserIdentityDesktop.Core.Models"
             xmlns:views="using:UserIdentityDesktop.Views"
             x:Class="UserIdentityDesktop.Views.WorkspaceView" x:Name="RootWorkspace" x:DataType="vm:WorkspaceViewModel"
             Background="{DynamicResource ForgeBg}" Foreground="{DynamicResource ForgeTextPrimary}" Classes.reduced-motion="{Binding ReduceMotion}">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="4" /></Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ForgeSurfaceCard}" />
      <Setter Property="Foreground" Value="{DynamicResource ForgeTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgePrimary}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource ForgeSurfaceCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource ForgeTextPrimary}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource ForgeBgSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgePrimary}" />
    </Style>
    <Style Selector="UserControl.reduced-motion TabItem"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="UserControl.reduced-motion Button"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="Border#NavigationRail">
      <Setter Property="Width" Value="70" />
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Width" Duration="0:0:0.24"><DoubleTransition.Easing><views:AngularNavigationEasing /></DoubleTransition.Easing></DoubleTransition></Transitions></Setter>
    </Style>
    <Style Selector="Border#NavigationRail.expanded"><Setter Property="Width" Value="210" /></Style>
    <Style Selector="Button.workspace-nav">
      <Setter Property="Width" Value="194" /><Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="14,12" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Foreground" Value="{DynamicResource ForgeTextSecondary}" />
      <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.workspace-nav.active"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /><Setter Property="Foreground" Value="{DynamicResource ForgePrimary}" /></Style>
    <Style Selector="Button.workspace-nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.workspace-nav TextBlock"><Setter Property="Opacity" Value="0" /><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" /></Transitions></Setter></Style>
    <Style Selector="Border#NavigationRail.expanded Button.workspace-nav TextBlock"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="TextBlock.sidebar-caption"><Setter Property="Opacity" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ForgeTextSecondary}" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border#NavigationRail.expanded TextBlock.sidebar-caption"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="UserControl.reduced-motion Border#NavigationRail"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="UserControl.reduced-motion Button.workspace-nav TextBlock"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="TabControl#WorkspaceTabs /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="Height" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /></Style>
  </UserControl.Styles>
  <UserControl.KeyBindings><KeyBinding Gesture="Ctrl+Alt+Escape" Command="{Binding StopControlCommand}" /></UserControl.KeyBindings>
  <Grid ColumnDefinitions="70,*">
  <Border x:Name="NavigationRail" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" ZIndex="20" ClipToBounds="True" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*,Auto" Margin="8,22,8,16">
      <StackPanel Height="28" Margin="14,0,14,8" Orientation="Horizontal" Spacing="16"><Border Width="24" Height="2" Background="{DynamicResource ForgeBorder}" /><TextBlock Classes="sidebar-caption" Text="{loc:Translate loc_5493ff8e9397}" VerticalAlignment="Center" /></StackPanel>
      <StackPanel Grid.Row="1" Spacing="8">
        <Button Classes="workspace-nav active" Tag="0" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_460b3a7da007}" ToolTip.Tip="{loc:Translate loc_460b3a7da007}"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M2,3 L22,3 22,17 8,17 2,22 Z M5,6 L19,6 19,14 7,14 5,16 Z" /><TextBlock Text="{loc:Translate loc_460b3a7da007}" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="6" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_420b916b4296}" ToolTip.Tip="{loc:Translate loc_420b916b4296}"><StackPanel Orientation="Horizontal" Spacing="12"><Grid><PathIcon Width="24" Height="24" Data="M6,2 L10,6 8,9 C10,13 12,15 16,16 L19,14 23,18 C22,25 13,23 7,17 1,11 0,4 6,2 Z"/><Border IsVisible="{Binding HasMissedCalls}" Background="{DynamicResource ForgePrimary}" CornerRadius="9" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-9,0"><TextBlock Text="{Binding MissedCalls}" Foreground="White" FontSize="10"/></Border></Grid><TextBlock Text="{loc:Translate loc_420b916b4296}" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="1" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_bca705b63a3c}" ToolTip.Tip="{loc:Translate loc_bca705b63a3c}"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M2,5 L16,5 16,19 2,19 Z M18,9 L23,6 23,18 18,15 Z" /><TextBlock Text="{loc:Translate loc_bca705b63a3c}" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="2" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_d5d0a30b517e}" ToolTip.Tip="{loc:Translate loc_d5d0a30b517e}"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M5,2 L7,2 7,5 17,5 17,2 19,2 19,5 22,5 22,22 2,22 2,5 5,5 Z M4,10 L4,20 20,20 20,10 Z M7,12 L10,12 10,15 7,15 Z M13,12 L16,12 16,15 13,15 Z" /><TextBlock Text="{loc:Translate loc_d5d0a30b517e}" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="3" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_fe02680f2479}" ToolTip.Tip="{loc:Translate loc_fe02680f2479}"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M2,8 L9,8 20,3 20,21 9,16 7,16 8,22 4,22 3,16 2,16 Z M22,9 L24,9 24,15 22,15 Z" /><TextBlock Text="{loc:Translate loc_fe02680f2479}" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="5" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_788011833a5a}" ToolTip.Tip="{loc:Translate loc_788011833a5a}"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M12,2 C8,2 5,5 5,9 L5,16 2,19 22,19 19,16 19,9 C19,5 16,2 12,2 Z M9,21 C9,25 15,25 15,21 Z" /><TextBlock Text="{loc:Translate loc_788011833a5a}" VerticalAlignment="Center" /></StackPanel></Button>
      </StackPanel>
      <Button Grid.Row="2" Classes="workspace-nav" Tag="4" Click="Navigate_Click" AutomationProperties.Name="{loc:Translate loc_8936c7a7975e}" ToolTip.Tip="{loc:Translate loc_8936c7a7975e}"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M3,5 L21,5 21,7 3,7 Z M3,11 L21,11 21,13 3,13 Z M3,17 L21,17 21,19 3,19 Z M7,2 L9,2 9,10 7,10 Z M15,8 L17,8 17,16 15,16 Z M7,14 L9,14 9,22 7,22 Z" /><TextBlock Text="{loc:Translate loc_8936c7a7975e}" VerticalAlignment="Center" /></StackPanel></Button>
    </Grid>
  </Border>
  <Grid Grid.Column="1">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Classes="connection-banner" IsVisible="{Binding ShowConnectionBanner}"><TextBlock Text="{Binding ConnectionBannerText}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextPrimary}" AutomationProperties.Name="{loc:Translate loc_a4e35c5d0909}"/></Border>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" IsVisible="{Binding MediaBusy}" />
    <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding SelectedWorkspaceTab, Mode=TwoWay}" Grid.Row="2" Margin="0" Padding="0" BorderThickness="0" FontSize="13">
      <TabItem Header="{loc:Translate loc_460b3a7da007}">
        <ContentControl Content="{Binding Chat}" />
      </TabItem>
      <TabItem Header="{loc:Translate loc_bca705b63a3c}">
        <ScrollViewer><StackPanel Margin="28" Spacing="24">
          <StackPanel Spacing="6"><TextBlock Text="{loc:Translate loc_bca705b63a3c}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Translate loc_65499a883858}" Foreground="{DynamicResource ForgeTextSecondary}" /></StackPanel>
          <Border Classes="workspace-panel" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16"><TextBlock Text="{loc:Translate loc_b167216c64c7}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{loc:Translate loc_7b37b16b4ae8}" Foreground="{DynamicResource ForgeTextSecondary}" />
              <CheckBox Content="{loc:Translate loc_4a99a771eadd}" IsChecked="{Binding JoinMeetingMuted}" />
              <Grid ColumnDefinitions="*,Auto"><TextBox views:EnterSubmit.Command="{Binding JoinMeetingCommand}" Text="{Binding MeetingCode}" PlaceholderText="Meeting code" MinWidth="280" AutomationProperties.Name="{loc:Translate loc_c8ffd2bea6d6}" />
                <Button Classes="fire-btn" Grid.Column="1" Content="{loc:Translate loc_b167216c64c7}" Command="{Binding JoinMeetingCommand}" IsEnabled="{Binding CanStartCall}" Margin="12,0,0,0" /></Grid>
              <TextBlock Text="{loc:Translate loc_b12a90622aaf}" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" />
            </StackPanel>
          </Border>
          <Button Content="{loc:Translate loc_f097e1562302}" Command="{Binding OpenMeetingInvitationCommand}" HorizontalAlignment="Left"/>
          <Border Classes="workspace-panel" IsVisible="{Binding PendingMeetingInvitation, Converter={StaticResource NullToBoolConverter}}">
            <StackPanel Spacing="10"><TextBlock Text="{Binding MeetingInvitationTitle}" FontSize="18" FontWeight="Bold" />
              <Button Content="{loc:Translate loc_a26f0c4eaefc}" Command="{Binding ReviewMeetingInvitationCommand}" />
              <ItemsControl ItemsSource="{Binding MeetingInvitationConflicts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:CalendarConflict"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <CheckBox Content="{loc:Translate loc_cb5d4dc17602}" IsChecked="{Binding AcknowledgeMeetingConflicts}" />
              <Button Content="{loc:Translate loc_7e17aadc3039}" Command="{Binding AcceptMeetingInvitationCommand}" IsEnabled="{Binding MeetingInvitationReview, Converter={StaticResource NullToBoolConverter}}"/><Button Content="{loc:Translate loc_2ce06dafd875}" Command="{Binding DeclineMeetingInvitationCommand}"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource Glyph.Calendar}" Width="20" Height="20" Foreground="{DynamicResource ForgePrimary}"/><TextBlock Text="{loc:Translate loc_977a4ea7c810}" FontSize="19" FontWeight="SemiBold"/><Border CornerRadius="10" Background="{DynamicResource ForgePrimaryGradientSubtle}" Padding="8,3"><TextBlock Text="{Binding UpcomingMeetings.Length}" Foreground="{DynamicResource ForgePrimary}"/></Border></StackPanel>
          <TextBlock Text="{loc:Translate loc_79f747f6353b}" TextWrapping="Wrap" IsVisible="{Binding NoUpcomingMeetings}" Foreground="{DynamicResource ForgeTextMuted}"/>
          <ListBox IsVisible="{Binding !NoUpcomingMeetings}" ItemsSource="{Binding UpcomingMeetings}" SelectedItem="{Binding SelectedCalendar}" MaxHeight="360" Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate><DataTemplate x:DataType="model:CalendarItem">
              <Border Padding="18,16" Background="{DynamicResource ForgeSurfaceCard}" CornerRadius="12" Margin="0,4" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto"><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource ForgePrimaryGradientSubtle}" VerticalAlignment="Center"><PathIcon Data="{StaticResource Glyph.Camera}" Width="20" Height="20" Foreground="{DynamicResource ForgePrimary}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="5" Margin="14,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" /><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource ForgeTextMuted}" TextTrimming="CharacterEllipsis" MaxHeight="20" /></StackPanel>
                  <Button Grid.Column="2" Content="{loc:Translate loc_fd30fe681b4b}" Click="JoinMeetingCard_Click" VerticalAlignment="Center" Classes="quiet" />
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="12"><Button IsVisible="{Binding !NoUpcomingMeetings}" Content="{loc:Translate loc_be73aefeb8f9}" Classes="fire-btn" Command="{Binding JoinSelectedMeetingCommand}" IsEnabled="{Binding CanStartCall}" />
            <Button Content="{loc:Translate loc_5b08f3c71912}" Classes="quiet" Click="NewSchedule_Click" /></StackPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Translate loc_d5d0a30b517e}">
        <Grid x:Name="CalendarLayout" ColumnDefinitions="*,340" RowDefinitions="Auto,*" Margin="24">
          <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TabControl x:Name="CalendarTabs" SelectedIndex="{Binding SelectedCalendarTab}" views:TabMotion.Enabled="False"><TabItem Header="{loc:Translate loc_d5d0a30b517e}" /><TabItem Header="{loc:Translate loc_92930e0fb3a8}" /><TabItem Header="{loc:Translate loc_dd34938544cf}" /></TabControl>
            <Border x:Name="CalendarTabFocus" Background="{DynamicResource ForgePrimary}" Height="2" CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
              <Border.Transitions><Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.24"><ThicknessTransition.Easing><views:AngularNavigationEasing /></ThicknessTransition.Easing></ThicknessTransition><DoubleTransition Property="Width" Duration="0:0:0.24"><DoubleTransition.Easing><views:AngularNavigationEasing /></DoubleTransition.Easing></DoubleTransition></Transitions></Border.Transitions>
            </Border>
          </Grid>
              <ScrollViewer x:Name="VacationPage" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsVacationTab}" views:EnterSubmit.MultilineNewLine="True" views:EnterSubmit.Command="{Binding ReviewVacationRequestCommand}">
                <StackPanel Spacing="10">
                  <Button Content="{loc:Translate loc_02d9e59c6de1}" Classes="fire-btn" Click="NewVacation_Click" HorizontalAlignment="Left" />
                  <TextBlock Text="{loc:Translate loc_b1ea0583c4a2}" FontWeight="Bold" />
                  <Button Content="{loc:Translate loc_2ce6d3e734cb}" Command="{Binding RefreshVacationsCommand}" />
                  <ListBox ItemsSource="{Binding Vacations}" SelectedItem="{Binding SelectedVacation}" MaxHeight="280"><ListBox.ItemTemplate><DataTemplate x:DataType="model:VacationRequest"><StackPanel Margin="8"><TextBlock Text="{Binding RequesterName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource ForgePrimary}" FontWeight="Bold" /><TextBlock Text="{Binding RequestedDays, StringFormat='{}{0} working days'}" /><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" /><TextBlock Text="{Binding DatesLabel}" Classes="caption" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                  <WrapPanel IsEnabled="{Binding !IsLoading}"><Button Content="{loc:Translate loc_6007acbe30b2}" Command="{Binding DecideVacationCommand}" CommandParameter="Approve" IsVisible="{Binding CanApproveVacation}" /><Button Content="{loc:Translate loc_ab604a360777}" Command="{Binding DecideVacationCommand}" CommandParameter="Reject" IsVisible="{Binding CanApproveVacation}" /><Button Content="{loc:Translate loc_164546a9c548}" Command="{Binding DecideVacationCommand}" CommandParameter="Withdraw" IsVisible="{Binding CanWithdrawVacation}" /><Button Content="{loc:Translate loc_b622a0428783}" Command="{Binding DecideVacationCommand}" CommandParameter="RequestCancellation" IsVisible="{Binding CanRequestVacationCancellation}" /><Button Content="{loc:Translate loc_040f7f9e4c20}" Command="{Binding DecideVacationCommand}" CommandParameter="ConfirmCancellation" IsVisible="{Binding CanConfirmVacationCancellation}" /></WrapPanel>
                  <Button Content="{loc:Translate loc_48e964799c5f}" Command="{Binding MoreVacationsCommand}" IsVisible="{Binding VacationsHaveMore}" />
                </StackPanel>
              </ScrollViewer>
          <ScrollViewer x:Name="VacationEditor" IsVisible="False" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" views:EnterSubmit.MultilineNewLine="True" views:EnterSubmit.Command="{Binding ReviewVacationRequestCommand}">
            <StackPanel Spacing="20" IsEnabled="{Binding !IsLoading}">
              <ItemsControl ItemsSource="{Binding VacationBalances}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:VacationBalance">
                <views:ComposeAutoGrid MinimumItemWidth="130" Gap="12">
                  <Border Classes="compose-card" CornerRadius="13" Padding="16" MinHeight="90"><StackPanel Spacing="6"><TextBlock Text="{loc:Translate loc_b1e50ff137a0}" FontSize="12.8"/><TextBlock Text="{Binding Entitlement, StringFormat='{}{0:0.##}'}" FontWeight="Bold" FontSize="25.6" Foreground="{DynamicResource ForgePrimary}"/></StackPanel></Border>
                  <Border Classes="compose-card" CornerRadius="13" Padding="16" MinHeight="90"><StackPanel Spacing="6"><TextBlock Text="{loc:Translate loc_331551b0de41}" FontSize="12.8"/><TextBlock Text="{Binding Pending, StringFormat='{}{0:0.##}'}" FontWeight="Bold" FontSize="25.6" Foreground="{DynamicResource ForgePrimary}"/></StackPanel></Border>
                  <Border Classes="compose-card" CornerRadius="13" Padding="16" MinHeight="90"><StackPanel Spacing="6"><TextBlock Text="{loc:Translate loc_87b42e40c2a2}" FontSize="12.8"/><TextBlock Text="{Binding Approved, StringFormat='{}{0:0.##}'}" FontWeight="Bold" FontSize="25.6" Foreground="{DynamicResource ForgePrimary}"/></StackPanel></Border>
                  <Border Classes="compose-card" CornerRadius="13" Padding="16" MinHeight="90"><StackPanel Spacing="6"><TextBlock Text="{loc:Translate loc_c76e6790bc5b}" FontSize="12.8"/><TextBlock Text="{Binding Taken, StringFormat='{}{0:0.##}'}" FontWeight="Bold" FontSize="25.6" Foreground="{DynamicResource ForgePrimary}"/></StackPanel></Border>
                  <Border Classes="compose-card" CornerRadius="13" Padding="16" MinHeight="90"><StackPanel Spacing="6"><TextBlock Text="{loc:Translate loc_e674447337e8}" FontSize="12.8"/><TextBlock Text="{Binding Available, StringFormat='{}{0:0.##}'}" FontWeight="Bold" FontSize="25.6" Foreground="{DynamicResource ForgePrimary}"/></StackPanel></Border>
                </views:ComposeAutoGrid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Border x:Name="VacationRequestCard" Classes="compose-card"><StackPanel Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,36" ColumnSpacing="12">
                  <StackPanel Spacing="14"><TextBlock Classes="compose-title" Text="{loc:Translate loc_a0f65b104bc5}"/><TextBlock Classes="form-help" Text="{loc:Translate loc_e6f46b4f5974}"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding VacationBalanceYear, StringFormat='Balance year {0}'}" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" VerticalAlignment="Top"/>
                </Grid>
                <Border Classes="form-note" Margin="0,0,0,16" IsVisible="{Binding ShowVacationPrerequisite}"><TextBlock Text="{Binding VacationInstructions}" Classes="form-help"/></Border>
                <Grid Classes="form-pair" ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="16">
                  <StackPanel Spacing="7"><TextBlock Classes="form-label" Text="{loc:Translate loc_1e1be0102d63}"/><CalendarDatePicker Tag="VacationStart" SelectedDate="{Binding VacationStart, Mode=TwoWay, Converter={StaticResource LocalCalendarDateConverter}}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Translate loc_1e1be0102d63}"/></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="7"><TextBlock Classes="form-label" Text="{loc:Translate loc_6943cac04957}"/><CalendarDatePicker Tag="VacationEnd" SelectedDate="{Binding VacationEnd, Mode=TwoWay, Converter={StaticResource LocalCalendarDateConverter}}" DisplayDateStart="{Binding VacationStart, Converter={StaticResource LocalCalendarDateConverter}}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Translate loc_6943cac04957}"/></StackPanel>
                </Grid>
                <Border Classes="form-note" Margin="0,28,0,20"><StackPanel Spacing="6" AutomationProperties.Name="{loc:Translate loc_c1a8678b9705}">
                  <TextBlock Text="{Binding VacationPlanSummary}" TextWrapping="Wrap" AutomationProperties.Name="{loc:Translate loc_36eadd2014be}" Foreground="{DynamicResource ForgePrimary}" FontSize="22.4" FontWeight="Bold"/>
                  <TextBlock Classes="form-help" Text="{Binding VacationPlanHelp}"/>
                  <ScrollViewer MaxHeight="340" Margin="0,12,0,10" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding VacationShifts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><views:ComposeAutoGrid MinimumItemWidth="220" Gap="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:VacationShift"><Border Classes="vacation-day-card" MinHeight="76" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel Spacing="6"><TextBlock Text="{Binding AnchorDate, StringFormat='{}{0:dddd, d MMM yyyy}'}" FontWeight="Bold" FontSize="16" LineHeight="24"/><TextBlock Text="{Binding HoursLabel}" Classes="form-help" LineHeight="20.4"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <TextBlock Text="{Binding VacationBalanceImpact}" TextWrapping="Wrap" FontSize="16" LineHeight="24" Margin="0,0,0,0"/>
                </StackPanel></Border>
                <StackPanel Spacing="8"><TextBlock Classes="form-label" Text="{loc:Translate loc_0f7d4664a9bc}"/>
                  <TextBox Tag="VacationReason" Text="{Binding VacationReason}" PlaceholderText="Anything your approver should know" AcceptsReturn="True" MinHeight="96" MaxHeight="240" TextWrapping="Wrap" MaxLength="2000" AutomationProperties.Name="{loc:Translate loc_83901ae253f1}"/>
                </StackPanel>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="CalendarBrowser" Grid.Row="1" IsVisible="{Binding IsCalendarTab}" RowDefinitions="Auto,*,Auto" Margin="0,0,18,0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16"><TextBlock Text="{loc:Translate loc_d5d0a30b517e}" FontSize="24" FontWeight="SemiBold" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{loc:Translate loc_0e9161011702}" Classes="quiet" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" /><Button Content="{loc:Translate loc_3bfe90620277}" Classes="fire-btn" Click="NewSchedule_Click" /></StackPanel></Grid>
            <ScrollViewer Grid.Row="1"><StackPanel Spacing="16">
              <ComboBox IsVisible="{Binding !IsOrganizationCalendarTab}" ItemsSource="{Binding CalendarPeople}" SelectedItem="{Binding SelectedCalendarPerson}" HorizontalAlignment="Stretch" PlaceholderText="My calendar and reporting team"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:WorkplacePerson"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <ComboBox IsVisible="{Binding IsOrganizationCalendarTab}" ItemsSource="{Binding SharedCalendars}" SelectedItem="{Binding SelectedSharedCalendar}" PlaceholderText="Choose an authorized organization or unit"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:SharedCalendarChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Border Classes="workspace-panel"><views:ScheduleCalendar x:Name="MonthCalendar" FocusDate="{Binding RangeDate}" Items="{Binding Calendar}" /></Border>
              <TextBlock Text="{Binding DateRange}" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="{loc:Translate loc_2bea1ac694aa}" IsVisible="{Binding !HasDaySchedule}" Foreground="{DynamicResource ForgeTextSecondary}" />
              <ListBox ItemsSource="{Binding DaySchedule}" SelectedItem="{Binding SelectedCalendar}" MaxHeight="240">
                <ListBox.ItemTemplate><DataTemplate x:DataType="model:CalendarItem"><StackPanel Margin="10" Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
