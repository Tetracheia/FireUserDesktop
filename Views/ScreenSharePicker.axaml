<Window FlowDirection="{ReflectionBinding Direction, Source={x:Static loc:LocalizedStrings.Shared}}" xmlns="https://github.com/avaloniaui" xmlns:loc="using:UserIdentityDesktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:UserIdentityDesktop.ViewModels" xmlns:model="using:UserIdentityDesktop.Core.Models"
        x:Class="UserIdentityDesktop.Views.ScreenSharePicker" x:DataType="vm:ScreenSharePickerViewModel"
        Title="{loc:Translate loc_3607f96ef888}" Width="620" Height="480" MinWidth="420" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ForgeSurface}" Foreground="{DynamicResource ForgeTextPrimary}">
  <Window.Styles>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,4" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /></Style>
  </Window.Styles>
  <Window.Resources><DataTemplate x:Key="Source" x:DataType="model:ScreenShareSource"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="12,10" /></DataTemplate></Window.Resources>
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <TextBlock Text="{loc:Translate loc_3607f96ef888}" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="{Binding Hint}" Foreground="{DynamicResource ForgeTextSecondary}" TextWrapping="Wrap" />
    <TabControl x:Name="SourceTabs" Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{loc:Translate loc_c4ca45472c34}"><ListBox x:Name="ScreenSources" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" ItemTemplate="{StaticResource Source}" Background="Transparent" /></TabItem>
      <TabItem Header="{loc:Translate loc_19734a1b58ca}"><Grid><TextBlock Text="{loc:Translate loc_3e5b30061cb8}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Windows.Count}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" /><ListBox x:Name="WindowSources" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" ItemTemplate="{StaticResource Source}" Background="Transparent" /></Grid></TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{loc:Translate loc_19766ed6ccb2}" Click="Cancel_Click" /><Button x:Name="ShareButton" Content="{loc:Translate loc_29887a5ff984}" Classes="fire-btn" IsEnabled="{Binding CanShare}" Click="Share_Click" /></StackPanel>
  </Grid>
</Window>
