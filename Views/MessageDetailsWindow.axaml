<Window FlowDirection="{ReflectionBinding Direction, Source={x:Static loc:LocalizedStrings.Shared}}" xmlns="https://github.com/avaloniaui" xmlns:loc="using:UserIdentityDesktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:UserIdentityDesktop.ViewModels"
        x:Class="UserIdentityDesktop.Views.MessageDetailsWindow" x:DataType="vm:MessageDetailsViewModel" Title="{loc:Translate loc_1c8313102993}" Width="560" Height="620" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner" WindowDecorations="Full" Background="{DynamicResource ForgeSurface}" Foreground="{DynamicResource ForgeTextPrimary}">
  <ScrollViewer><StackPanel Margin="24" Spacing="18">
    <TextBlock Text="{loc:Translate loc_1c8313102993}" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="{Binding RefreshError}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeDanger}" IsVisible="{Binding RefreshError, Converter={StaticResource NullToBoolConverter}}"/>
    <Border Classes="detail-card"><SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="130" /></Border>
    <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Glyph.Send}" Width="17" Height="17"/><TextBlock Text="{loc:Translate loc_c16bc82bf1f0}" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding Sender}"/><SelectableTextBlock Text="{Binding SentAt}"/><TextBlock Text="{loc:Translate loc_d2efaae61d5a}" Classes="caption"/></StackPanel>
    <StackPanel IsVisible="{Binding ShowReceipts}" Spacing="18">
      <StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Glyph.Users}" Width="17" Height="17"/><TextBlock Text="{loc:Translate loc_7fb44fd2c9db}" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{loc:Translate loc_34e9544e3574}" IsVisible="{Binding NoReaders}" Classes="caption"/>
        <ItemsControl ItemsSource="{Binding SeenRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MessageReceiptRow"><Grid ColumnDefinitions="*,Auto" Margin="0,5" ColumnSpacing="16"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><SelectableTextBlock Grid.Column="1" Text="{Binding Time}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Playback}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MessagePlaybackSection"><StackPanel Spacing="10" Margin="0,0,0,18"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Glyph.Audio}" Width="17" Height="17"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><TextBlock Text="{loc:Translate loc_41b854920418}" IsVisible="{Binding IsEmpty}" Classes="caption"/><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MessageReceiptRow"><Grid ColumnDefinitions="*,Auto" Margin="0,5" ColumnSpacing="16"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><SelectableTextBlock Grid.Column="1" Text="{Binding Time}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </StackPanel></ScrollViewer>
</Window>
