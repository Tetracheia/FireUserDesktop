<Window FlowDirection="{ReflectionBinding Direction, Source={x:Static loc:LocalizedStrings.Shared}}" xmlns="https://github.com/avaloniaui" xmlns:loc="using:UserIdentityDesktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UserIdentityDesktop.ViewModels" x:Class="UserIdentityDesktop.Views.RemoteControlRequestWindow"
        x:DataType="vm:WorkspaceViewModel" Width="380" SizeToContent="Height" CanResize="False"
        WindowDecorations="None" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Title="{loc:Translate loc_9ead07b44dfa}" Background="{DynamicResource ForgeSurface}" Foreground="{DynamicResource ForgeTextPrimary}">
  <Border Padding="20" BorderBrush="{DynamicResource ForgePrimary}" BorderThickness="2" CornerRadius="12">
    <StackPanel Spacing="12">
      <TextBlock Text="{loc:Translate loc_9ead07b44dfa}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ControlRequesterName, StringFormat='{}{0} requests keyboard and mouse control of your shared desktop.'}" TextWrapping="Wrap" />
      <TextBlock Text="{loc:Translate loc_890a81de0498}" TextWrapping="Wrap" />
      <TextBlock x:Name="Countdown" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{loc:Translate loc_6007acbe30b2}" Command="{Binding AllowControlCommand}" AutomationProperties.Name="{loc:Translate loc_8947ba7d1a76}" />
        <Button Content="{loc:Translate loc_ab604a360777}" Command="{Binding DenyControlCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
