<UserControl FlowDirection="{ReflectionBinding Direction, Source={x:Static loc:LocalizedStrings.Shared}}" xmlns="https://github.com/avaloniaui" xmlns:loc="using:UserIdentityDesktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserIdentityDesktop.ViewModels" xmlns:views="using:UserIdentityDesktop.Views" x:Class="UserIdentityDesktop.Views.ChatView"
             x:Name="RootChatView" x:DataType="vm:ChatViewModel" Background="{DynamicResource ForgeBg}"
             Foreground="{DynamicResource ForgeTextPrimary}" Classes.reduced-motion="{Binding Workspace.ReduceMotion}">
  <UserControl.Styles>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /></Style>
    <Style Selector="ListBox.message-stream"><Setter Property="Padding" Value="28,20" /></Style>
    <Style Selector="ListBox.message-stream ListBoxItem:selected /template/ ContentPresenter, ListBox.message-stream ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Border.recipient-row Button.recipient-more"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.recipient-row:pointerover Button.recipient-more, Button.recipient-more:focus"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="TextBox.composer"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,10" /></Style>
    <Style Selector="TabControl.details-tabs TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="9,8" /><Setter Property="MinHeight" Value="36" /></Style>
  </UserControl.Styles>
  <Panel>
    <Grid x:Name="ChatLayout" ColumnDefinitions="300,*">
      <Border Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="22,22,16,14">
            <StackPanel Spacing="4"><TextBlock Text="{loc:Translate loc_ef5b4049bb36}" FontSize="24" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="{Binding FilteredRecipients.Count, StringFormat='{}{0} conversations'}" /></StackPanel>
            <Button x:Name="FindPeopleButton" Grid.Column="1" Classes="quiet square" VerticalAlignment="Center" ToolTip.Tip="{loc:Translate loc_396c946f0c79}" AutomationProperties.Name="{loc:Translate loc_396c946f0c79}">
              <PathIcon Data="{StaticResource Glyph.Plus}" Width="18" Height="18" />
              <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><StackPanel Width="320" Spacing="12">
                <TextBlock Text="{loc:Translate loc_1775489b305a}" FontSize="17" FontWeight="SemiBold" />
                <TextBox Text="{Binding IdentitySearchText}" PlaceholderText="Search by name or email" AutomationProperties.Name="{loc:Translate loc_17a85d8fc08a}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" Height="2" />
                <ScrollViewer MaxHeight="320"><ItemsControl x:Name="PeopleSearchResults" ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UserSearchItemViewModel">
                  <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding #RootChatView.((vm:ChatViewModel)DataContext).StartChatFromSearchCommand}" CommandParameter="{Binding}" Click="SearchResult_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ForgePrimaryGradientSubtle}"><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding FullName}" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              </StackPanel></Flyout></Button.Flyout>
            </Button>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding SearchText}" PlaceholderText="Search conversations" Margin="16,0,16,14" AutomationProperties.Name="{loc:Translate loc_8abdf3b226e7}" />
          <ListBox Grid.Row="2" ItemsSource="{Binding FilteredRecipients}" SelectedItem="{Binding SelectedRecipient}" Margin="10,0" Padding="0,0,0,12">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:RecipientItemViewModel">
              <Border Classes="recipient-row" Padding="12,14" ContextRequested="Recipient_ContextRequested">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel Width="42" Height="42"><Border CornerRadius="21" Background="{DynamicResource ForgePrimaryGradientSubtle}"><TextBlock Text="{Binding Initials}" FontSize="14" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Border CornerRadius="21" ClipToBounds="True" IsVisible="{Binding Avatar, Converter={StaticResource NullToBoolConverter}}"><Image Source="{Binding Avatar}" Stretch="UniformToFill" /></Border><Border Background="{DynamicResource ForgeSurface}" CornerRadius="9" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding !IsGroup}"><views:PresenceIndicator HasMobileConnection="{Binding HasMobileConnection}" Status="{Binding Status}" Width="13" Height="13"/></Border></Panel>
                  <StackPanel Grid.Column="1" Margin="12,2,6,0" Spacing="5"><TextBlock Text="{Binding ReceiverName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="5"><TextBlock Text="{Binding PreviewText}" FontSize="12" Foreground="{DynamicResource ForgeTextMuted}" TextTrimming="CharacterEllipsis" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasPreviewAttachments}"><PathIcon Data="{StaticResource Glyph.Attach}" Width="12" Height="12" Foreground="{DynamicResource ForgeTextMuted}" /><TextBlock Text="{Binding AttachmentsCount}" FontSize="12" Foreground="{DynamicResource ForgeTextMuted}" /></StackPanel></Grid></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right"><TextBlock Classes="caption"  ><TextBlock.Text><MultiBinding Converter="{StaticResource DateTimeFormatConverter}"><Binding Path="LastSent"/><Binding Source="{x:Static vm:ClockDisplaySettings.Shared}" Path="TwelveHour" x:DataType="vm:ClockDisplaySettings"/></MultiBinding></TextBlock.Text></TextBlock><Button Classes="quiet recipient-more" Width="24" Height="22" Padding="4" Click="RecipientMenu_Click" AutomationProperties.Name="{loc:Translate loc_ef3683c4bbe2}"><PathIcon Data="{StaticResource Glyph.More}" Width="15" Height="15" /></Button><Ellipse Width="6" Height="6" Fill="{DynamicResource ForgePrimary}" IsVisible="{Binding !IsSeen}" /></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="3" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,1,0,0" Padding="16,14">
            <Grid ColumnDefinitions="Auto,*,Auto"><Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Background="{DynamicResource ForgePrimaryGradientSubtle}"><Panel><TextBlock Text="{Binding CurrentUser.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForgePrimary}"/><Image Source="{Binding MyAvatar}" Stretch="UniformToFill" AutomationProperties.Name="{loc:Translate loc_3ac552449a69}"/></Panel></Border><StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding CurrentUser.DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Spacing="6"><views:PresenceIndicator Status="{Binding CurrentUserStatus}" Width="12" Height="12"/><TextBlock Classes="caption" FontSize="12" Text="{Binding CurrentStatusLabel}" /></StackPanel></StackPanel>
              <Button Grid.Column="2" Classes="quiet square" Click="AccountMenu_Click" AutomationProperties.Name="{loc:Translate loc_7fb5995bca43}"><PathIcon Data="{StaticResource Glyph.More}" Width="18" Height="18" /></Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" x:Name="ConversationSurface" ColumnDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding SelectedRecipient, Converter={StaticResource NullToBoolConverter}}">
          <Border Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="ConversationProfileButton" Grid.ColumnSpan="2" Classes="quiet" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="HeaderProfile_Click" AutomationProperties.Name="{loc:Translate loc_3dd6a563e154}"><Grid ColumnDefinitions="Auto,*"><Border x:Name="ReceiverAvatar" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource ForgePrimaryGradientSubtle}"><Border.Clip><EllipseGeometry Rect="0,0,40,40" /></Border.Clip><Panel><TextBlock Text="{Binding SelectedRecipientInitials}" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding SelectedRecipientAvatar}" Stretch="UniformToFill" /></Panel></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding SelectedRecipientName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="16" /><StackPanel Orientation="Horizontal" Spacing="6"><views:PresenceIndicator HasMobileConnection="{Binding SelectedRecipientHasMobileConnection}" Status="{Binding SelectedRecipientStatus}" IsVisible="{Binding SelectedRecipientHasPresence}"/><TextBlock Text="{Binding SelectedRecipientStatusLabel}" Classes="caption"/></StackPanel></StackPanel></Grid></Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="quiet square" Command="{Binding Workspace.StartVoiceCommand}" IsEnabled="{Binding Workspace.CanStartCall}" ToolTip.Tip="{loc:Translate loc_8b968cce31a0}" AutomationProperties.Name="{loc:Translate loc_8b968cce31a0}"><PathIcon Data="{StaticResource Glyph.Phone}" Width="18" Height="18" /></Button>
                <Button Classes="quiet square" Command="{Binding Workspace.StartVideoCommand}" IsEnabled="{Binding Workspace.CanStartCall}" ToolTip.Tip="{loc:Translate loc_7b79b4f67293}" AutomationProperties.Name="{loc:Translate loc_7b79b4f67293}"><PathIcon Data="{StaticResource Glyph.Camera}" Width="19" Height="19" /></Button>
                <Button Classes="quiet square" Click="ConversationMenu_Click" ToolTip.Tip="{loc:Translate loc_28b55e125877}" AutomationProperties.Name="{loc:Translate loc_ef3683c4bbe2}"><PathIcon Data="{StaticResource Glyph.More}" Width="19" Height="19" /></Button>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <Button Content="{loc:Translate loc_561a197a2807}" Classes="quiet" Command="{Binding LoadMoreMessagesCommand}" IsVisible="{Binding HasMoreMessages}" HorizontalAlignment="Center" Margin="0,8" />
            <ListBox x:Name="MessageStream" Grid.Row="1" Classes="message-stream" ItemsSource="{Binding Messages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                <views:ChatMessageCard Chat="{Binding #RootChatView.((vm:ChatViewModel)DataContext)}"/>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingMessages}" VerticalAlignment="Top" Height="2" Grid.Row="1" />
            <Border Grid.Row="2" IsVisible="{Binding HasChatActivity}" HorizontalAlignment="Left" Margin="28,4,28,8" Padding="12,9" CornerRadius="16" Background="{DynamicResource ForgeSurfaceCard}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M9,2 C9,0 15,0 15,2 L15,11 C15,15 9,15 9,11 Z M5,10 L7,10 7,11 C7,18 17,18 17,11 L17,10 19,10 19,11 C19,15 16,18 13,18 L13,21 17,21 17,23 7,23 7,21 11,21 11,18 C8,18 5,15 5,11 Z" IsVisible="{Binding IsRecordingActivity}" Width="16" Height="16" Foreground="{DynamicResource ForgePrimary}"/><TextBlock Text="{Binding ChatActivityLabel}" Classes="caption" TextWrapping="Wrap"/></StackPanel></Border>
          </Grid>
          <StackPanel Grid.Row="2" Margin="24,10,24,18" Spacing="8" views:EnterSubmit.Command="{Binding SendMessageCommand}">
            <Border IsVisible="{Binding HasMessageAction}" BorderBrush="{DynamicResource ForgePrimary}" BorderThickness="2,0,0,0" Background="{DynamicResource ForgeSurface}" CornerRadius="8" Padding="12,9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding MessageActionLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="quiet square" Command="{Binding CancelMessageActionCommand}" AutomationProperties.Name="{loc:Translate loc_583bcc0ecd42}"><PathIcon Data="{StaticResource Glyph.Close}" Width="12" Height="12" /></Button></Grid></Border>
            <ItemsControl ItemsSource="{Binding PendingAttachments}" IsVisible="{Binding PendingAttachments.Count}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PendingAttachmentViewModel"><Border Classes="detail-card" Padding="10,6" Margin="0,0,6,4"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding FileName}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Classes="quiet square" Command="{Binding #RootChatView.((vm:ChatViewModel)DataContext).RemovePendingAttachmentCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{loc:Translate loc_595b066a8838}"><PathIcon Data="{StaticResource Glyph.Close}" Width="10" Height="10" /></Button></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border IsVisible="{Binding CanTypeMessage}" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" CornerRadius="14" Padding="7"><Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
              <Button Classes="quiet square" Command="{Binding AttachFilesCommand}" VerticalAlignment="Bottom" ToolTip.Tip="{loc:Translate loc_e697cc1e45af}" AutomationProperties.Name="{loc:Translate loc_e697cc1e45af}"><PathIcon Data="{StaticResource Glyph.Attach}" Width="17" Height="20" /></Button>
              <Button Grid.Column="1" x:Name="EmojiButton" Classes="quiet square" IsEnabled="{Binding !IsSendingMessage}" Click="Emoji_Click" VerticalAlignment="Bottom" ToolTip.Tip="{loc:Translate loc_d8506d01323b}" AutomationProperties.Name="{loc:Translate loc_d8506d01323b}"><PathIcon Data="{StaticResource Glyph.Emoji}" Width="19" Height="19" /></Button>
              <TextBox Grid.Column="2" x:Name="MessageInputBox" Classes="composer" FontFamily="fonts:Outfit#Outfit, Noto Color Emoji, Segoe UI Emoji, Apple Color Emoji" Text="{Binding MessageDraft}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="120" PlaceholderText="Write a message…" AutomationProperties.Name="{loc:Translate loc_2f77668a9dfb}" />
              <Button Grid.Column="3" x:Name="RecordComposerButton" Width="46" IsVisible="{Binding ShowRecordAction}" Classes="quiet square" Command="{Binding ToggleVoiceRecordingCommand}" Foreground="{DynamicResource ForgePrimary}" ToolTip.Tip="{Binding VoiceRecordingLabel}" AutomationProperties.Name="{Binding VoiceRecordingLabel}"><PathIcon Width="16" Height="20" Data="M9,2 C9,0 15,0 15,2 L15,11 C15,15 9,15 9,11 Z M5,10 L7,10 7,11 C7,18 17,18 17,11 L17,10 19,10 19,11 C19,15 16,18 13,18 L13,21 17,21 17,23 7,23 7,21 11,21 11,18 C8,18 5,15 5,11 Z" /></Button>
              <Button Grid.Column="3" x:Name="SendComposerButton" Width="46" IsVisible="{Binding ShowSendAction}" Classes="fire-btn square" Command="{Binding SendMessageCommand}" IsEnabled="{Binding !IsSendingMessage}" VerticalAlignment="Bottom" ToolTip.Tip="{loc:Translate loc_e523e78036c4}" AutomationProperties.Name="{loc:Translate loc_93a26b1eaff9}"><PathIcon Data="{StaticResource Glyph.Send}" Width="18" Height="18" /></Button>
            </Grid></Border>
            <Border x:Name="VoiceComposer" IsVisible="{Binding VoiceComposerActive}" Background="{DynamicResource ForgeBgSecondary}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1.5" CornerRadius="32" Padding="16,6,8,6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Classes="quiet square" Command="{Binding DiscardVoiceNoteCommand}" IsEnabled="{Binding !IsSendingMessage}" Foreground="{DynamicResource ForgePrimary}" CornerRadius="22" ToolTip.Tip="{loc:Translate loc_bf593b940262}" AutomationProperties.Name="{loc:Translate loc_bf593b940262}"><PathIcon Width="22" Height="22" Data="F0 M6,7 L18,7 17,21 7,21 Z M4,4 L9,4 10,2 14,2 15,4 20,4 20,6 4,6 Z M9,9 L11,9 11,19 9,19 Z M13,9 L15,9 15,19 13,19 Z" /></Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !HasVoiceNote}">
                  <PathIcon Width="22" Height="22" Foreground="{DynamicResource ForgePrimary}" Data="M9,2 C9,0 15,0 15,2 L15,11 C15,15 9,15 9,11 Z M5,10 L7,10 7,11 C7,18 17,18 17,11 L17,10 19,10 19,11 C19,15 16,18 13,18 L13,21 17,21 17,23 7,23 7,21 11,21 11,18 C8,18 5,15 5,11 Z" />
                  <TextBlock Text="{Binding VoiceStatusLabel}" Foreground="{DynamicResource ForgeTextPrimary}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <views:InlineAudioPlayer Grid.Column="1" LocalPath="{Binding VoiceNotePath}" MaxWidth="Infinity" IsVisible="{Binding HasVoiceNote}" AutomationProperties.Name="{loc:Translate loc_62dae4fdd835}" />
                <Button Grid.Column="2" Classes="quiet square" Command="{Binding ToggleVoiceRecordingCommand}" IsVisible="{Binding IsRecordingVoice}" Foreground="{DynamicResource ForgePrimary}" CornerRadius="22" ToolTip.Tip="{loc:Translate loc_3d591e826d54}" AutomationProperties.Name="{loc:Translate loc_3d591e826d54}"><PathIcon Width="22" Height="22" Data="F0 M12,1 A11,11 0 1 0 12,23 A11,11 0 1 0 12,1 Z M8,8 L16,8 16,16 8,16 Z" /></Button>
                <Button Grid.Column="3" Classes="fire-btn square" Command="{Binding SendMessageCommand}" IsVisible="{Binding HasVoiceNote}" IsEnabled="{Binding !IsSendingMessage}" CornerRadius="24" ToolTip.Tip="{loc:Translate loc_95f25188de01}" AutomationProperties.Name="{loc:Translate loc_95f25188de01}"><PathIcon Data="{StaticResource Glyph.Send}" Width="18" Height="18" /></Button>
              </Grid>
            </Border>
            <TextBlock Text="{Binding AttachmentSendingStage}" IsVisible="{Binding IsUploadingAttachments}" Classes="caption" />
            <TextBlock Text="{Binding SendError}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeDanger}" FontSize="12" IsVisible="{Binding SendError, Converter={StaticResource NullToBoolConverter}}" />
          </StackPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340" IsVisible="{Binding SelectedRecipient, Converter={StaticResource NullToBoolConverter}, ConverterParameter=invert}"><Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource ForgePrimaryGradientSubtle}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Glyph.Chat}" Width="30" Height="30" Foreground="{DynamicResource ForgePrimary}" /></Border><TextBlock Text="{loc:Translate loc_cfcf693e8ec6}" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{loc:Translate loc_47fffc709dfa}" Foreground="{DynamicResource ForgeTextMuted}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        <Border Grid.Column="1" x:Name="ConversationDrawer" Width="310" views:RevealMotion.Kind="Drawer" views:RevealMotion.IsOpen="{Binding ShowConversationDetails}" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1,0,0,0" Padding="18">
          <Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16"><StackPanel Spacing="4"><TextBlock Text="{loc:Translate loc_28b55e125877}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedRecipientName}" Classes="caption" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Classes="quiet square" Command="{Binding CloseConversationDetailsCommand}" AutomationProperties.Name="{loc:Translate loc_8569442ef3b3}"><PathIcon Data="{StaticResource Glyph.Close}" Width="13" Height="13" /></Button></Grid>
            <TabControl Grid.Row="1" Classes="details-tabs" SelectedIndex="{Binding ConversationDetailsTab}" FontSize="12">
              <TabItem Header="{loc:Translate loc_abc7e9892806}"><Grid RowDefinitions="Auto,*,Auto"><Button Content="{loc:Translate loc_e2b488cb6e0d}" Classes="quiet" Command="{Binding LoadAttachmentsCommand}" HorizontalAlignment="Left" /><ListBox Grid.Row="1" ItemsSource="{Binding AllAttachments}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChatAttachmentItemViewModel"><Button Classes="quiet" Click="SharedAttachment_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Spacing="5"><TextBlock Text="{Binding FileName}" MaxWidth="230" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FormattedFileSize}" Classes="caption" /></StackPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="{loc:Translate loc_ac8991ef0101}" Classes="quiet" Command="{Binding MoreAttachmentsCommand}" /></Grid></TabItem>
              <TabItem Header="{loc:Translate loc_1044a4c056d0}"><StackPanel Spacing="14" Margin="0,16"><TextBlock Text="{loc:Translate loc_ec63df27966b}" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Workspace.People}" SelectedItem="{Binding SelectedNewMember}" PlaceholderText="Choose a colleague" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PersonSelection"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="{loc:Translate loc_fc38cf0178ff}" Classes="fire-btn" Command="{Binding AddMemberCommand}" /><TextBlock Text="{loc:Translate loc_ad20d3f3c25d}" Classes="caption" TextWrapping="Wrap" /></StackPanel></TabItem>
              <TabItem Header="{loc:Translate loc_8f6fb4eb7f42}"><ScrollViewer><StackPanel Spacing="12" Margin="0,16"><TextBlock Text="{loc:Translate loc_eb4a8ca05c93}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding SecurityStatus}" Classes="caption" TextWrapping="Wrap" /><Button Content="{loc:Translate loc_442c4b893915}" Classes="quiet" Command="{Binding LoadSecurityCommand}" /><TextBox Text="{Binding Workspace.ChatPin}" PasswordChar="●" PlaceholderText="Your six-digit PIN" MaxLength="6" /><Button Content="{loc:Translate loc_27350d6bb1a5}" Classes="fire-btn" Command="{Binding Workspace.UnlockChatCommand}" />
                <Expander Header="{loc:Translate loc_6a35b6165e66}"><StackPanel Spacing="10" Margin="0,12,0,0"><TextBox Text="{Binding SecurityPin}" PasswordChar="●" PlaceholderText="Current or new PIN" MaxLength="6" /><TextBox Text="{Binding SecurityConfirmation}" PasswordChar="●" PlaceholderText="Confirm new PIN" MaxLength="6" /><Button Content="{loc:Translate loc_02c6183e04dc}" Command="{Binding ChangeSecurityCommand}" CommandParameter="Set" /><TextBox Text="{Binding SecurityPassword}" PasswordChar="●" PlaceholderText="Account password" /><Button Content="{loc:Translate loc_594c6a5f7e61}" Command="{Binding ChangeSecurityCommand}" CommandParameter="Disable" /></StackPanel></Expander>
                <Expander Header="{loc:Translate loc_63aed5bd316c}"><StackPanel Spacing="10" Margin="0,12,0,0"><Button Content="{loc:Translate loc_8c774079d0e9}" Command="{Binding ChangeSecurityCommand}" CommandParameter="Recovery" /><TextBox Text="{Binding SecurityOtp}" PasswordChar="●" PlaceholderText="Emailed code" /><TextBox Text="{Binding SecurityPin}" PasswordChar="●" PlaceholderText="New PIN" MaxLength="6" /><Button Content="{loc:Translate loc_bedbaca26be5}" Command="{Binding ChangeSecurityCommand}" CommandParameter="Reset" /></StackPanel></Expander>
              </StackPanel></ScrollViewer></TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="ProfileOverlay" Background="#99000000" views:RevealMotion.Kind="Overlay" views:RevealMotion.IsOpen="{Binding IsProfileOverlayOpen}">
      <Border x:Name="ProfileCard" views:RevealMotion.IsOpen="{Binding IsProfileOverlayOpen}" MaxWidth="720" MaxHeight="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource ForgeSurface}" CornerRadius="20" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" Padding="26">
        <Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24"><Button Classes="quiet" Padding="0" Command="{Binding OpenImagePreviewCommand}"><Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ForgePrimaryGradientSubtle}" ClipToBounds="True"><Panel><TextBlock Text="{Binding ProfileInitials}" FontSize="22" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding ProfileAvatar}" Stretch="UniformToFill" /></Panel></Border></Button><StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding ProfileUserName}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding ProfileEmailText}" Foreground="{DynamicResource ForgeTextSecondary}" /></StackPanel><Button Grid.Column="2" Classes="quiet square" Command="{Binding CloseUserProfileCommand}" VerticalAlignment="Top" AutomationProperties.Name="{loc:Translate loc_402eed09289b}"><PathIcon Data="{StaticResource Glyph.Close}" Width="14" Height="14" /></Button></Grid>
          <ScrollViewer Grid.Row="1"><StackPanel Spacing="18"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingProfile}" Height="2" /><TextBlock Text="{loc:Translate loc_11a2442c0823}" Classes="section-label" /><TextBlock Text="{loc:Translate loc_75853f713843}" Foreground="{DynamicResource ForgeTextSecondary}" IsVisible="{Binding !HasProfileOrganization}" TextWrapping="Wrap" /><ContentControl Content="{Binding ProfileOrganization}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:ProfileOrganizationViewModel"><views:ProfileOrganizationView /></DataTemplate></ContentControl.ContentTemplate></ContentControl><TextBlock Text="{loc:Translate loc_f82ecbb5e510}" Classes="section-label" /><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><StackPanel Spacing="7"><TextBlock Text="{loc:Translate loc_63dceb8800b2}" Classes="caption" /><TextBlock Text="{Binding ProfilePhoneText}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{loc:Translate loc_56ef8f20955f}" Classes="caption" /><TextBlock Text="{Binding ProfileAddressText}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="10" Margin="0,24,0,0"><TextBox views:EnterSubmit.Command="{Binding SendQuickMessageCommand}" Text="{Binding QuickMessageText}" PlaceholderText="Send a quick message…" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><Button Content="{loc:Translate loc_7047b9af7a4c}" Classes="quiet" Command="{Binding StartChatFromProfileCommand}" /><Button Grid.Column="1" Content="{loc:Translate loc_93a26b1eaff9}" Classes="fire-btn" Command="{Binding SendQuickMessageCommand}" IsEnabled="{Binding !IsSendingQuickMessage}" /></Grid><TextBlock Text="{Binding QuickMessageStatus}" Classes="caption" /></StackPanel>
        </Grid>
      </Border>
    </Border>
    <Border Background="#E6101114" IsVisible="{Binding IsImagePreviewOpen}" Padding="30"><Grid RowDefinitions="Auto,*"><Button Content="{loc:Translate loc_7d8ab368210c}" Classes="quiet" Command="{Binding CloseImagePreviewCommand}" HorizontalAlignment="Right" /><Image Grid.Row="1" Source="{Binding ProfileAvatar}" Stretch="Uniform" /></Grid></Border>
  </Panel>
</UserControl>
